  <link name="laser">
    <visual>
      <geometry><box size="0.08 0.08 0.06"/></geometry>
      <material name="lidar_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="LINK_TORSO_YAW"/>
    <child link="laser"/>
    <origin xyz="0.12438 0 0.21289" rpy="0 0 0"/>
  </joint>
  <gazebo reference="laser">
    <sensor type="ray" name="rslidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.279253</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range><min>0.30</min><max>70.0</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="rslidar_plugin" filename="libgazebo_ros_block_laser.so">
        <topicName>/rslidar_block</topicName>
        <frameName>laser</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <link name="gnss">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="antenna_white"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="gnss_joint" type="fixed">
    <parent link="LINK_HEAD_YAW"/>
    <child link="gnss"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>
  <link name="gnss_aux">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="antenna_white"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="gnss_aux_joint" type="fixed">
    <parent link="LINK_HEAD_YAW"/>
    <child link="gnss_aux"/>
    <origin xyz="0 -0.07 0.22" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_link_head">
    <sensor type="camera" name="cam_head">
      <always_on>true</always_on>
      <update_rate>6</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.15</near><far>30</far></clip>
      </camera>
      <plugin name="cam_head_plugin" filename="libgazebo_ros_camera.so">
        <robotNamespace>/</robotNamespace>
        <cameraName>camera/cam_head</cameraName>
        <frameName>camera_link_head</frameName>
        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link_torso">
    <sensor type="camera" name="cam_torso">
      <always_on>true</always_on>
      <update_rate>6</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.15</near><far>20</far></clip>
      </camera>
      <plugin name="cam_torso_plugin" filename="libgazebo_ros_camera.so">
        <robotNamespace>/</robotNamespace>
        <cameraName>camera/cam_torso</cameraName>
        <frameName>camera_link_torso</frameName>
        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
