<?xml version="1.0"?>
<robot name="pm01_edu">
  <link name="body">
    <collision>
      <origin xyz="0.02 0 -0.781" rpy="0 0 0"/>
      <geometry><box size="0.70 0.42 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.40" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.2"/>
    </inertial>
  </link>
  <joint name="body_to_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="LINK_BASE"/>
  </joint>
  <link name="left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.04"/></geometry>
    </collision>
    <inertial><mass value="0.6"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <link name="right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.04"/></geometry>
    </collision>
    <inertial><mass value="0.6"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.18 -0.671" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.18 -0.671" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo>
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometrySource>world</odometrySource>
      <publishOdomTF>false</publishOdomTF>
      <robotBaseFrame>body</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishTf>true</publishTf>
      <publishWheelJointState>false</publishWheelJointState>
      <legacyMode>false</legacyMode>
      <updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.36</wheelSeparation>
      <wheelDiameter>0.30</wheelDiameter>
      <wheelAcceleration>8</wheelAcceleration>
      <wheelTorque>80</wheelTorque>
    </plugin>
  </gazebo>
  <gazebo reference="body">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>/imu/data</topicName>
        <frameName>body</frameName>
        <updateRateHZ>200</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="left_wheel"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>

