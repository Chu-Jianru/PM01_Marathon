<launch>
  <arg name="gui" default="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find pm01_marathon)/worlds/line_course.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <!-- 窗口要等控制器起来再开。和 gzserver 同时开时，仿真会停在零点几秒。 -->
    <arg name="gui" value="false"/>
    <arg name="headless" value="false"/>
  </include>

  <node if="$(arg gui)" name="gazebo_gui" pkg="gazebo_ros" type="gzclient" output="screen"
        launch-prefix="$(find pm01_marathon)/scripts/open_gazebo_gui.py"/>

  <param name="robot_description" textfile="$(find pm01_marathon)/urdf/pm01_edu.urdf"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
        args="-urdf -model pm01_edu -x 0 -y 0 -z 0.821 -param robot_description"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <node pkg="pm01_marathon" type="odom_bridge.py" name="odom_bridge" output="screen"/>
  <node pkg="pm01_marathon" type="gnss_ksxt.py" name="gnss_ksxt" output="screen"/>
  <node pkg="pm01_marathon" type="sidewalk_traffic.py" name="sidewalk_traffic" output="screen"/>
  <node pkg="glio_mapping" type="glio_mapping_node" name="laserMapping" output="screen"
        args="$(find pm01_marathon)/config/robosense_sim.yaml"/>
  <node pkg="pm01_marathon" type="glio_twist.py" name="glio_twist" output="screen"/>
  <node pkg="pm01_marathon" type="rslidar_points.py" name="rslidar_points" output="screen">
    <param name="horizontal_samples" value="360"/>
    <param name="vertical_samples" value="32"/>
    <param name="scan_period" value="0.1"/>
    <rosparam param="sensor_xyz">[0.1365, 0.0, 0.2938]</rosparam>
  </node>
  <node pkg="pm01_marathon" type="cloud_to_scan.py" name="cloud_to_scan" output="screen">
    <param name="range_max" value="70.0"/>
  </node>
  <node pkg="pm01_marathon" type="lane_paths.py" name="lane_paths" output="screen"/>

  <node pkg="tf" type="static_transform_publisher" name="map_to_camera_init"
        args="0 0 0 0 0 0 map camera_init 100"/>

  <include file="$(find costmap_converter)/launch/laserscan_obstacle_converter.launch">
    <arg name="scan_topic" value="/scan"/>
    <arg name="obstacles_topic" value="/obstacles_raw"/>
  </include>
  <node pkg="vo_navigation" type="lidar_obstacle_node" name="lidar_obstacle_node" output="screen">
    <rosparam command="load" file="$(find vo_navigation)/config/lidar_obstacle.yaml"/>
    <param name="target_frame" value="camera_init"/>
  </node>
  <node pkg="vo_navigation" type="subgoal_selector_node" name="subgoal_selector_node" output="screen">
    <rosparam command="load" file="$(find vo_navigation)/config/subgoal_selector.yaml"/>
  </node>
  <node pkg="vo_navigation" type="vo_node" name="vo_node" output="screen">
    <rosparam command="load" file="$(find vo_navigation)/config/vo_node.yaml"/>
    <param name="enable_runtime_debug" value="false"/>
    <param name="enable_file_log" value="false"/>
    <param name="goal_stop_distance" value="2.5"/>
  </node>

  <rosparam command="load" file="$(find speed_controller)/config/speed_controller.yaml"/>
  <node pkg="speed_controller" type="speed_controller_discrete" name="speed_controller_node" output="screen"/>
  <node pkg="topic_tools" type="relay" name="cmd_relay" args="/fuzzy_cmd_vel /cmd_vel"/>

  <rosparam command="load" file="$(find pm01_marathon)/config/gait_controllers.yaml"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen"
        args="joint_state_controller gait_controller"/>
  <node pkg="pm01_marathon" type="policy_gait.py" name="policy_gait" output="screen">
    <param name="policy_path" value="$(env HOME)/engineai_policy/zqsa01_policy.onnx"/>
    <param name="config_path" value="$(env HOME)/engineai_policy/zqsa01_rl.yaml"/>
  </node>
</launch>
